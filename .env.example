# Copy to .env.local. The Vite dev/preview server proxies /api/llm/* to this
# OpenAI-compatible endpoint and injects the key server-side (the browser never sees it).
#
# Local model (oMLX / vLLM / LM Studio):
#   LLM_PROXY_TARGET=http://127.0.0.1:8000/v1
#   LLM_MODEL=Qwen3.6-35B-A3B-UD-MLX-4bit
# Cloud (OpenRouter, Qwen):
#   LLM_PROXY_TARGET=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507
LLM_PROXY_TARGET=
LLM_API_KEY=
LLM_MODEL=
