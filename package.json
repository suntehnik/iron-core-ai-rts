{
  "name": "iron-core-ai-rts",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:ios": "tsc && vite build --mode ios --outDir ios/Web --emptyOutDir",
    "build:android": "tsc && vite build --mode android --outDir android/app/src/main/assets/web --emptyOutDir",
    "preview": "vite preview",
    "firebase": "npx --yes firebase-tools@15.33.0",
    "deploy": "npm run build && node scripts/check-deploy.mjs && npm run firebase -- deploy --only hosting",
    "deploy:preview": "npm run build && node scripts/check-deploy.mjs && npm run firebase -- hosting:channel:deploy preview --expires 7d",
    "test": "vitest run",
    "test:live": "LLM_LIVE=1 vitest run tests/llm-live.test.ts"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
